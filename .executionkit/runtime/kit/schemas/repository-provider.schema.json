{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elwazeery.github.io/ai-executionkit/repository-provider-v1.json",
  "title": "AI ExecutionKit Repository Intelligence Provider v1",
  "type": "object",
  "required":["schemaVersion","id","kind","optional","capabilities","status","health"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "kind":{"enum":["native","external"]},
    "optional":{"type":"boolean"},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "status":{"enum":["NOT_CONFIGURED","NOT_AVAILABLE","INCOMPATIBLE","READY","STALE","FAILED"]},
    "version":{"type":["string","null"]},
    "health":{
      "type":"object",
      "required":["reachable"],
      "properties":{
        "reachable":{"type":"boolean"},
        "checkedAt":{"type":["string","null"],"format":"date-time"},
        "baselineSha":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{7,64}$"},
        "reason":{"type":["string","null"]}
      },
      "additionalProperties":true
    }
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"READY"}},"required":["status"]},"then":{"properties":{"health":{"properties":{"reachable":{"const":true}},"required":["reachable"]}}}},
    {"if":{"properties":{"status":{"const":"STALE"}},"required":["status"]},"then":{"properties":{"health":{"required":["baselineSha"],"properties":{"baselineSha":{"type":"string","pattern":"^[A-Fa-f0-9]{7,64}$"}}}}}}
  ],
  "additionalProperties":true
}
