{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elwazeery.github.io/ai-executionkit/execution-config-v3.json",
  "title": "AI ExecutionKit v3 execution config",
  "type": "object",
  "required": [
    "standardVersion",
    "projectState",
    "profile",
    "capabilities",
    "ci",
    "agent",
    "state",
    "taskModel",
    "todoPath",
    "taskArchivePaths",
    "validStates",
    "documentation",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "standardVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectState": {
      "enum": [
        "BOOTSTRAP",
        "ACTIVE"
      ]
    },
    "profile": {
      "enum": [
        "LITE",
        "STANDARD",
        "FULL",
        "CUSTOM"
      ]
    },
    "customRationale": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "execution",
        "agent",
        "content",
        "seo",
        "audit",
        "test",
        "launch"
      ],
      "properties": {
        "execution": {
          "$ref": "#/$defs/level"
        },
        "agent": {
          "$ref": "#/$defs/level"
        },
        "content": {
          "$ref": "#/$defs/level"
        },
        "seo": {
          "$ref": "#/$defs/level"
        },
        "audit": {
          "$ref": "#/$defs/level"
        },
        "test": {
          "$ref": "#/$defs/level"
        },
        "launch": {
          "$ref": "#/$defs/level"
        }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "required": [
        "provider",
        "executionMode",
        "githubHostedAllowed",
        "automaticPushRuns",
        "projectRunnerLabel",
        "maxProjectRunnersPerDevice",
        "allowedRunnerOS"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "executionMode": {
          "const": "self-hosted-manual"
        },
        "githubHostedAllowed": {
          "const": false
        },
        "automaticPushRuns": {
          "const": false
        },
        "allowedAutomaticWorkflowPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectRunnerLabel": {
          "type": "string",
          "pattern": "^project-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "maxProjectRunnersPerDevice": {
          "const": 1
        },
        "allowedRunnerOS": {
          "type": "array",
          "items": {
            "enum": [
              "macOS",
              "windows"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": [
        "manifestPath"
      ],
      "properties": {
        "manifestPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "operator": {
      "type": "object",
      "required": [
        "entrypoint",
        "additionalBootstrapPromptRequired",
        "hostChecklistMode",
        "syncHostChecklistAfterTask",
        "fullCiCadence",
        "targetedTaskVerification",
        "hostPersistenceAuthority"
      ],
      "properties": {
        "entrypoint": {
          "const": "todo-first"
        },
        "additionalBootstrapPromptRequired": {
          "const": false
        },
        "hostChecklistMode": {
          "const": "derived-mirror"
        },
        "syncHostChecklistAfterTask": {
          "const": true
        },
        "fullCiCadence": {
          "const": "phase-boundary"
        },
        "targetedTaskVerification": {
          "const": true
        },
        "hostPersistenceAuthority": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "SEQUENTIAL",
            "DEPENDENCY_SAFE_PARALLEL"
          ]
        },
        "oneLifecycleActionAtATime": {
          "type": "boolean"
        },
        "allowBoundedHostDelegation": {
          "type": "boolean"
        },
        "checkpointPath": {
          "const": ".executionkit/runtime/checkpoint.json"
        },
        "parallel": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxConcurrentTasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxAgentsPerTask": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "requireExplicitParallelSafe": {
              "type": "boolean"
            },
            "requireOwnership": {
              "type": "boolean"
            },
            "isolatedWorktrees": {
              "type": "boolean"
            },
            "integrationOwner": {
              "type": "string",
              "minLength": 1
            },
            "sequentialFallback": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "maxConcurrentTasks",
            "maxAgentsPerTask",
            "requireExplicitParallelSafe",
            "requireOwnership",
            "isolatedWorktrees",
            "integrationOwner",
            "sequentialFallback"
          ]
        },
        "boost": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "command": {
              "const": "/boost"
            },
            "maxConcurrentTasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maxAgentsPerTask": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "qualityGatesPreserved": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "command",
            "maxConcurrentTasks",
            "maxAgentsPerTask",
            "qualityGatesPreserved"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SEQUENTIAL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "oneLifecycleActionAtATime": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "DEPENDENCY_SAFE_PARALLEL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "oneLifecycleActionAtATime": {
                "const": false
              },
              "parallel": {
                "type": "object",
                "required": [
                  "enabled",
                  "maxConcurrentTasks",
                  "maxAgentsPerTask",
                  "requireExplicitParallelSafe",
                  "requireOwnership",
                  "isolatedWorktrees",
                  "integrationOwner",
                  "sequentialFallback"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "maxConcurrentTasks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  },
                  "maxAgentsPerTask": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  },
                  "requireExplicitParallelSafe": {
                    "const": true
                  },
                  "requireOwnership": {
                    "const": true
                  },
                  "isolatedWorktrees": {
                    "const": true
                  },
                  "integrationOwner": {
                    "const": "orchestrator"
                  },
                  "sequentialFallback": {
                    "const": true
                  }
                },
                "additionalProperties": false
              },
              "boost": {
                "type": "object",
                "required": [
                  "enabled",
                  "command",
                  "maxConcurrentTasks",
                  "maxAgentsPerTask",
                  "qualityGatesPreserved"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "command": {
                    "const": "/boost"
                  },
                  "maxConcurrentTasks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "maxAgentsPerTask": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "qualityGatesPreserved": {
                    "const": true
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "parallel",
              "boost"
            ]
          }
        }
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "oneLifecycleActionAtATime",
        "allowBoundedHostDelegation",
        "checkpointPath"
      ]
    },
    "state": {
      "type": "object",
      "required": [
        "enabled",
        "snapshotPath",
        "journalPath",
        "checkpointOnRuntimeTransitions",
        "requireRehydrateOnDrift",
        "heartbeatMinutes",
        "memory"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "snapshotPath": {
          "type": "string",
          "pattern": "^\\.executionkit/"
        },
        "journalPath": {
          "type": "string",
          "pattern": "^\\.executionkit/"
        },
        "checkpointOnRuntimeTransitions": {
          "type": "boolean"
        },
        "requireRehydrateOnDrift": {
          "const": true
        },
        "heartbeatMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        },
        "memory": {
          "type": "object",
          "required": [
            "mode",
            "authority",
            "requireLiveRevalidation",
            "allowTaskState"
          ],
          "properties": {
            "mode": {
              "enum": [
                "auto",
                "disabled",
                "required"
              ]
            },
            "authority": {
              "const": "advisory"
            },
            "requireLiveRevalidation": {
              "const": true
            },
            "allowTaskState": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fleet": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agentMode": {
          "enum": [
            "per-device"
          ]
        },
        "hostActivity": {
          "enum": [
            "local-pulse"
          ]
        },
        "remoteControl": {
          "enum": [
            "disabled",
            "typed"
          ]
        },
        "telemetry": {
          "type": "object",
          "required": [
            "transport",
            "authority",
            "uploadTodoContent",
            "uploadSourceContent",
            "shareLocalPaths"
          ],
          "properties": {
            "transport": {
              "enum": [
                "local-agent"
              ]
            },
            "authority": {
              "const": "observational"
            },
            "uploadTodoContent": {
              "const": false
            },
            "uploadSourceContent": {
              "const": false
            },
            "shareLocalPaths": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scopePath": {
          "type": "string",
          "minLength": 1
        },
        "inventoryPath": {
          "type": "string",
          "pattern": "^\\.executionkit/"
        },
        "reconciliationPath": {
          "type": "string",
          "pattern": "^\\.executionkit/"
        },
        "requiredForRelease": {
          "type": "boolean"
        },
        "failOnDeclaredMissing": {
          "const": true
        },
        "allowEmptyScopeForRelease": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "candidateRequiredForRelease": {
          "type": "boolean"
        },
        "adapterConfigPath": {
          "type": "string",
          "minLength": 1
        },
        "maxAgeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "requiredProducers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requireTestAdequacy": {
          "type": "boolean"
        },
        "testReportPath": {
          "type": "string"
        },
        "testFormat": {
          "enum": [
            "tap",
            "junit",
            "playwright-json",
            ""
          ]
        },
        "minimumTests": {
          "type": "integer",
          "minimum": 0
        },
        "allowSkipped": {
          "type": "boolean"
        },
        "allowFlaky": {
          "type": "boolean"
        },
        "requireDurableTaskEvidence": {
          "type": "boolean"
        },
        "taskProofRoot": {
          "type": "string",
          "minLength": 1
        },
        "releaseTruthMode": {
          "const": "STRICT"
        }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "required": [
        "contractPath",
        "requiredForRelease"
      ],
      "properties": {
        "contractPath": {
          "type": "string",
          "minLength": 1
        },
        "requiredForRelease": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "premiumExperience": {
      "type": "object",
      "required": [
        "applicability",
        "qualityProfile",
        "notApplicableReason"
      ],
      "properties": {
        "applicability": {
          "enum": [
            "UNRESOLVED",
            "REQUIRED",
            "NOT_APPLICABLE"
          ]
        },
        "qualityProfile": {
          "enum": [
            "UNRESOLVED",
            "premium",
            "standard"
          ]
        },
        "notApplicableReason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "properties": {
              "qualityProfile": {
                "const": "UNRESOLVED"
              },
              "notApplicableReason": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "REQUIRED"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "properties": {
              "qualityProfile": {
                "const": "premium"
              },
              "notApplicableReason": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "properties": {
              "qualityProfile": {
                "const": "standard"
              },
              "notApplicableReason": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "properties": {
        "runtimePath": {
          "enum": [
            ".executionkit/runtime/kit",
            ".executionkit/runtime/AI-ExecutionKit"
          ]
        }
      },
      "required": [
        "runtimePath"
      ],
      "additionalProperties": false
    },
    "taskModel": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "canonical-blocks",
            "projection-json",
            "native-markdown"
          ]
        },
        "projectionPath": {
          "type": "string"
        },
        "projectionCommand": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "adoption": {
      "type": "object",
      "properties": {
        "deepIntegrationRequired": {
          "type": "boolean"
        },
        "integrationPhase": {
          "type": "string",
          "minLength": 1
        },
        "integrationGateTaskId": {
          "type": "string",
          "minLength": 1
        },
        "integrationActivationTaskId": {
          "type": "string",
          "minLength": 1
        },
        "productExecutionBlockedUntilGateAccepted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deepIntegrationRequired": {
                "const": true
              }
            },
            "required": [
              "deepIntegrationRequired"
            ]
          },
          "then": {
            "required": [
              "integrationPhase",
              "integrationGateTaskId",
              "productExecutionBlockedUntilGateAccepted"
            ],
            "properties": {
              "productExecutionBlockedUntilGateAccepted": {
                "const": true
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "todoPath": {
      "type": "string",
      "minLength": 1
    },
    "taskArchivePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "validStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stateAliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "acceptedStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verifiedStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "terminalStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "archiveTerminalStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencySatisfiedStates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cancellationSatisfiesDependencies": {
      "type": "boolean"
    },
    "referenceKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scanCompetingBacklogs": {
      "type": "boolean"
    },
    "backlogScanRoots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignoreBacklogPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competingBacklogAsError": {
      "type": "boolean"
    },
    "forbidManualProgressPercentages": {
      "type": "boolean"
    },
    "requireEvidenceForVerified": {
      "type": "boolean"
    },
    "requireContractForReady": {
      "type": "boolean"
    },
    "requireVerificationField": {
      "type": "boolean"
    },
    "requireBlockerForBlocked": {
      "type": "boolean"
    },
    "requireCancellationReason": {
      "type": "boolean"
    },
    "requireExecutorForInProgress": {
      "type": "boolean"
    },
    "validateMarkdownAnchors": {
      "type": "boolean"
    },
    "rejectPlaceholdersWhenActive": {
      "type": "boolean"
    },
    "quality": {
      "type": "object",
      "required": [
        "contractPath"
      ],
      "properties": {
        "contractPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "editors": {
      "type": "object",
      "properties": {
        "antigravity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "distributionRepository": {
      "type": "boolean"
    },
    "integration": {
      "type": "object",
      "required": [
        "requirePhaseConvergenceForClosure",
        "minTasksForPhaseGate",
        "journeyContractPath",
        "requireCriticalJourneysForRelease",
        "allowNotApplicableForRelease",
        "requireSystemReleaseGate",
        "systemReleaseGateTaskId",
        "requireJourneyDenominator"
      ],
      "properties": {
        "requirePhaseConvergenceForClosure": {
          "type": "boolean"
        },
        "minTasksForPhaseGate": {
          "type": "integer",
          "minimum": 1
        },
        "journeyContractPath": {
          "type": "string",
          "minLength": 1
        },
        "requireCriticalJourneysForRelease": {
          "type": "boolean"
        },
        "allowNotApplicableForRelease": {
          "type": "boolean"
        },
        "requireSystemReleaseGate": {
          "type": "boolean"
        },
        "systemReleaseGateTaskId": {
          "type": "string",
          "minLength": 1
        },
        "requireJourneyDenominator": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "repositoryIntelligence": {
      "type": "object",
      "required": [
        "enabled",
        "storage",
        "privacy",
        "thresholds",
        "providers",
        "context",
        "refresh",
        "ingestion"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storage": {
          "type": "object",
          "required": [
            "portableRoot",
            "localRoot",
            "contextPath",
            "engineeringPath",
            "externalKnowledgePath"
          ],
          "properties": {
            "portableRoot": {
              "type": "string",
              "pattern": "^\\.executionkit/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            },
            "localRoot": {
              "type": "string",
              "pattern": "^\\.executionkit/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            },
            "contextPath": {
              "type": "string",
              "pattern": "^\\.executionkit/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
            },
            "engineeringPath": {
              "type": "string",
              "pattern": "^\\.executionkit/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
            },
            "externalKnowledgePath": {
              "type": "string",
              "pattern": "^\\.executionkit/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
            }
          },
          "additionalProperties": false
        },
        "privacy": {
          "type": "object",
          "required": [
            "allowSourceEgress",
            "includeSecretSensitivePaths",
            "extraDenyPaths"
          ],
          "properties": {
            "allowSourceEgress": {
              "const": false
            },
            "includeSecretSensitivePaths": {
              "const": false
            },
            "extraDenyPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "required": [
            "trustedMin",
            "verifyMin",
            "degradedMin"
          ],
          "properties": {
            "trustedMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "verifyMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "degradedMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "providers": {
          "type": "object",
          "required": [
            "required",
            "optional"
          ],
          "properties": {
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "optional": {
