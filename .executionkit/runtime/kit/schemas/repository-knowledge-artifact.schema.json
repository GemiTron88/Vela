{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elwazeery.github.io/ai-executionkit/repository-knowledge-artifact-v1.json",
  "title": "AI ExecutionKit Repository Knowledge Artifact v1",
  "type": "object",
  "required": ["schemaVersion","artifactId","artifactType","ownershipClass","evidenceKind","repository","provider","generatedAt","sourceScopes","trust","portable"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "artifactId": {"type":"string","minLength":1},
    "artifactType": {"type":"string","minLength":1},
    "ownershipClass": {"enum":["HUMAN_MAINTAINED","GENERATED_PORTABLE","LOCAL_DERIVED"]},
    "evidenceKind": {"enum":["LIVE_SOURCE","SOURCE_INDEX","RELATIONSHIP_GRAPH","GENERATED_CONTEXT","GENERATED_HUMAN_DOC","HUMAN_DOMAIN_KNOWLEDGE","EXTERNAL_ADVISORY"]},
    "repository": {
      "type":"object",
      "required":["key","isGit","baselineSha","dirty"],
      "properties":{
        "key":{"type":"string","minLength":1},
        "isGit":{"type":"boolean"},
        "baselineSha":{"type":["string","null"],"pattern":"^[A-Fa-f0-9]{7,64}$"},
        "branch":{"type":["string","null"]},
        "dirty":{"type":"boolean"}
      },
      "allOf":[
        {"if":{"properties":{"isGit":{"const":true}},"required":["isGit"]},"then":{"properties":{"baselineSha":{"type":"string","pattern":"^[A-Fa-f0-9]{7,64}$"}}}},
        {"if":{"properties":{"isGit":{"const":false}},"required":["isGit"]},"then":{"properties":{"baselineSha":{"const":null}}}}
      ],
      "additionalProperties":false
    },
    "provider": {
      "type":"object",
      "required":["id"],
      "properties":{"id":{"type":"string","minLength":1},"version":{"type":["string","null"]}},
      "additionalProperties":true
    },
    "generatedAt":{"type":"string","format":"date-time"},
    "sourceScopes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}},
    "inputFingerprints":{"type":"array","items":{"type":"object","required":["kind","value"],"properties":{"kind":{"type":"string","minLength":1},"value":{"type":"string","minLength":1}},"additionalProperties":false}},
    "metrics":{"type":"object","properties":{"bytes":{"type":"integer","minimum":0},"tokens":{"type":"integer","minimum":0},"fileCount":{"type":"integer","minimum":0}},"additionalProperties":true},
    "trust":{
      "type":"object",
      "required":["state","measuredAt","reasons"],
      "properties":{
        "state":{"enum":["TRUSTED","VERIFY","DEGRADED","SOURCE_ONLY","UNAVAILABLE"]},
        "measuredAt":{"type":"string","format":"date-time"},
        "score":{"type":"integer","minimum":0,"maximum":100},
        "reasons":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      },
      "additionalProperties":false
    },
    "portable":{"type":"boolean"}
  },
  "allOf":[
    {"if":{"properties":{"ownershipClass":{"const":"LOCAL_DERIVED"}},"required":["ownershipClass"]},"then":{"properties":{"portable":{"const":false}}}}
  ],
  "additionalProperties":true
}
