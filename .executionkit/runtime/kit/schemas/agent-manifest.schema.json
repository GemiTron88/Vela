{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elwazeery.github.io/ai-executionkit/agent-manifest-v2.2.json",
  "title": "AI ExecutionKit Agent OS manifest v2.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "standardVersion",
    "taskAuthority",
    "resources",
    "routing",
    "resolution",
    "delegation"
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "execution",
              "agent",
              "state",
              "content",
              "seo",
              "docs",
              "audit",
              "test",
              "launch",
              "visual",
              "decision"
            ]
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "native": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conflictsWith": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowedRoles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "riskLevel": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "adapterFor": {
          "type": "string"
        },
        "adapterForWorkflow": {
          "type": "string"
        },
        "adapterHost": {
          "enum": [
            "antigravity"
          ]
        }
      },
      "additionalProperties": true
    },
    "resourceRefs": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tagsAny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "when",
        "use"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "priority": {
          "type": "integer"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "use": {
          "$ref": "#/$defs/resourceRefs"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.2.0"
    },
    "standardVersion": {
      "type": "string",
      "minLength": 1
    },
    "taskAuthority": {
      "type": "object",
      "required": [
        "path",
        "mutableStateOwner",
        "shadowBacklogsForbidden"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mutableStateOwner": {
          "type": "string",
          "minLength": 1
        },
        "shadowBacklogsForbidden": {
          "const": true
        },
        "mode": {
          "enum": [
            "single-file",
            "sharded"
          ]
        },
        "shardRoot": {
          "type": "string",
          "minLength": 1
        },
        "archiveRoot": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "roles",
        "skills",
        "rules",
        "contracts",
        "templates"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "strategy",
        "routes",
        "fallback"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "first-match",
            "priority-first-match"
          ]
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "fallback": {
          "$ref": "#/$defs/resourceRefs"
        },
        "supplements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "minimalContext",
        "expandSkillDependencies"
      ],
      "properties": {
        "minimalContext": {
          "type": "boolean"
        },
        "expandSkillDependencies": {
          "type": "boolean"
        },
        "deterministicTieBreak": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "delegation": {
      "type": "object",
      "required": [
        "mode",
        "coordinatorRole",
        "reviewSeparationRequired",
        "oneLifecycleActionAtATime"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SEQUENTIAL",
            "DEPENDENCY_SAFE_PARALLEL"
          ]
        },
        "coordinatorRole": {
          "type": "string"
        },
        "reviewSeparationRequired": {
          "type": "boolean"
        },
        "allowBoundedHostDelegation": {
          "type": "boolean"
        },
        "oneLifecycleActionAtATime": {
          "type": "boolean"
        },
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxAgentsPerTask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "requireExplicitParallelSafe": {
          "type": "boolean"
        },
        "requireOwnership": {
          "type": "boolean"
        },
        "isolatedWorktrees": {
          "type": "boolean"
        },
        "integrationOwner": {
          "type": "string",
          "minLength": 1
        },
        "sequentialFallback": {
          "const": true
        },
        "boostCommand": {
          "const": "/boost"
        },
        "boostMaxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "boostMaxAgentsPerTask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "qualityGatesPreserved": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SEQUENTIAL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "oneLifecycleActionAtATime": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "DEPENDENCY_SAFE_PARALLEL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "oneLifecycleActionAtATime": {
                "const": false
              },
              "sequentialFallback": {
                "const": true
              },
              "qualityGatesPreserved": {
                "const": true
              },
              "requireExplicitParallelSafe": {
                "const": true
              },
              "requireOwnership": {
                "const": true
              },
              "isolatedWorktrees": {
                "const": true
              },
              "integrationOwner": {
                "const": "role.orchestrator"
              },
              "boostCommand": {
                "const": "/boost"
              }
            },
            "required": [
              "maxConcurrentTasks",
              "maxAgentsPerTask",
              "requireExplicitParallelSafe",
              "requireOwnership",
              "isolatedWorktrees",
              "integrationOwner",
              "sequentialFallback",
              "boostCommand",
              "boostMaxConcurrentTasks",
              "boostMaxAgentsPerTask",
              "qualityGatesPreserved"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
