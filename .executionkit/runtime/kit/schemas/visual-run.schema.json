{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "executionkit-visual-run/v2"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "impact"
      ]
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "gitTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "producerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "censusDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedCells": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "executionkit-visual-artifact/v2"
          },
          "runId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "cellId": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "actualRoute": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "gitSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "gitTree": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "captureTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "app": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "environment": {
                "type": "string",
                "enum": [
                  "test",
                  "staging"
                ]
              }
            },
            "required": [
              "identity",
              "revision",
              "environment"
            ],
            "additionalProperties": false
          },
          "persona": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "direction": {
            "type": "string",
            "enum": [
              "rtl",
              "ltr"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "viewport": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "state": {
            "type": "string",
            "enum": [
              "loaded",
              "loading",
              "skeleton",
              "empty",
              "zero-results",
              "validation-error",
              "server-error",
              "offline",
              "permission-denied",
              "success",
              "destructive-confirmation",
              "modal-open",
              "drawer-open",
              "dropdown-open",
              "filters-open",
              "form-filled",
              "saving",
              "upload-progress",
              "pagination",
              "long-content",
              "dense-data",
              "minimal-data"
            ]
          },
          "dataState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "captureExtent": {
            "type": "string",
            "enum": [
              "viewport",
              "full-page"
            ]
          },
          "fixtureSet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "fixtureHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stateHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "engine": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "playwright",
                  "android-adb",
                  "ios-simulator",
                  "flutter-instrumented"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "producerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "type",
              "version",
              "producerId"
            ],
            "additionalProperties": false
          },
          "image": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "perceptualHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "sha256",
              "perceptualHash",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "geometry": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "trace": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "runtime": {
            "type": "object",
            "properties": {
              "consoleErrors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "exceptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "failedRequests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "httpErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    }
                  },
                  "required": [
                    "url",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "unexpectedRedirects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "flutterExceptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "consoleErrors",
              "exceptions",
              "failedRequests",
              "httpErrors",
              "unexpectedRedirects",
              "flutterExceptions",
              "complete"
            ],
            "additionalProperties": false
          },
          "privacy": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "const": "synthetic-fixtures"
              },
              "maskCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "policy",
              "maskCount"
            ],
            "additionalProperties": false
          },
          "journey": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "journeyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "checkpointId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "runId",
              "journeyId",
              "checkpointId"
            ],
            "additionalProperties": false
          },
          "signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "schemaVersion",
          "runId",
          "cellId",
          "surfaceId",
          "route",
          "actualRoute",
          "gitSha",
          "gitTree",
          "captureTime",
          "app",
          "persona",
          "locale",
          "direction",
          "theme",
          "viewport",
          "state",
          "dataState",
          "captureExtent",
          "fixtureSet",
          "fixtureHash",
          "stateHash",
          "engine",
          "image",
          "geometry",
          "runtime",
          "privacy",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "cellId",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "gitSha",
    "gitTree",
    "startedAt",
    "completedAt",
    "producerId",
    "configDigest",
    "planDigest",
    "censusDigest",
    "expectedCells",
    "entries",
    "failures",
    "signature"
  ],
  "additionalProperties": false,
  "title": "visual-run v2"
}
