{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://elwazeery.github.io/ai-executionkit/repository-provider-status-v1.json",
  "title":"AI ExecutionKit Repository Provider Status v1",
  "type":"object",
  "required":["schemaVersion","checkedAt","providers"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "checkedAt":{"type":"string","format":"date-time"},
    "providers":{"type":"array","items":{
      "type":"object",
      "required":["schemaVersion","id","kind","optional","capabilities","status","health"],
      "properties":{
        "schemaVersion":{"const":"1.0.0"},
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
        "kind":{"enum":["native","external"]},
        "optional":{"type":"boolean"},
        "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "status":{"enum":["NOT_CONFIGURED","NOT_AVAILABLE","INCOMPATIBLE","READY","STALE","FAILED"]},
        "version":{"type":["string","null"]},
        "health":{"type":"object","required":["reachable","checkedAt"],"properties":{"reachable":{"type":"boolean"},"checkedAt":{"type":"string","format":"date-time"},"baselineSha":{"type":["string","null"]},"reason":{"type":["string","null"]},"currentHead":{"type":["string","null"]}},"additionalProperties":true}
      },
      "additionalProperties":true
    }}
  },
  "additionalProperties":false
}
