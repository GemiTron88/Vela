{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionKit candidate envelope",
  "type": "object",
  "required": ["schemaVersion","candidateId","commit","tree","dirty","generatedAt","hashes","platform","arch","node","environment","buildId"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "candidateId": {"type":"string","pattern":"^[a-f0-9]{20}$"},
    "commit": {"type":"string","minLength":7},
    "tree": {"type":"string","minLength":7},
    "dirty": {"const":false},
    "generatedAt": {"type":"string","format":"date-time"},
    "hashes": {"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "platform": {"type":"string","minLength":1},
    "arch": {"type":"string","minLength":1},
    "node": {"type":"string","minLength":1},
    "environment": {"type":"string","minLength":1},
    "buildId": {"type":["string","null"]}
  },
  "additionalProperties": true
}
