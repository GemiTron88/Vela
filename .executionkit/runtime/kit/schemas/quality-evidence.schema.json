{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionKit product quality evidence",
  "type": "object",
  "required": ["schemaVersion", "results"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "outcome", "observedAt", "producer", "environment", "verification", "sourceHashes", "artifacts"],
        "properties": {
          "requirementId": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "observedAt": {"type": "string", "format": "date-time"},
          "producer": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1},
          "exitCode": {"type": "integer"},
          "sourceHashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
