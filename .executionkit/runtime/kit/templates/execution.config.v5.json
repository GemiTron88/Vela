    "requireCriticalJourneysForRelease": true,
    "allowNotApplicableForRelease": false,
    "requireSystemReleaseGate": false,
    "systemReleaseGateTaskId": "REL-AUDIT",
    "requireJourneyDenominator": true,
    "releaseGateAuthority": "runtime-exact-candidate"
